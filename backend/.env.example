# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-DB-USER]:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-DB-USER]:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Security & Authentication
JWT_SECRET="generate_a_random_secure_64_char_string_for_production"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="ChooseAStrongAdminPassword123!"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Frontend URL (for CORS and redirects)
FRONTEND_URL="http://localhost:3000"

# SMTP Configuration (Nodemailer for transactional emails & OTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_16_character_app_password"

# Safepay PK Payment Gateway
SAFEPAY_API_KEY="sec_your_safepay_api_key"
SAFEPAY_SECRET="your_safepay_secret"
SAFEPAY_WEBHOOK_SECRET="your_safepay_webhook_secret"
SAFEPAY_ENVIRONMENT="sandbox" # or "production"
SAFEPAY_WEBHOOK_URL="https://yourdomain.com/api/webhook/safepay"

# Cloudinary (Media & Image Uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# OpenAI (AI Description Generator & Search)
OPENAI_API_KEY="sk-proj-your_openai_api_key"

# TCS Courier Integration (Optional)
TCS_API_URL="https://api.tcscourier.com/production/v1"
TCS_CLIENT_ID="your_tcs_client_id"
TCS_USERNAME="your_tcs_username"
TCS_PASSWORD="your_tcs_password"
TCS_COST_CENTER="your_tcs_cost_center"

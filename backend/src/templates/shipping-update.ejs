<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #111111; max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #111111; padding-bottom: 20px; }
        .logo { font-size: 24px; font-weight: 900; letter-spacing: -1px; }
        .dot { color: #FF3B30; }
        .content { background: #fafafa; padding: 30px; border: 1px solid #e5e5e5; }
        h2 { font-size: 20px; margin-top: 0; }
        .button { display: inline-block; background: #FF3B30; color: #ffffff !important; text-decoration: none; padding: 12px 24px; font-weight: bold; font-size: 14px; margin-top: 20px; text-transform: uppercase; letter-spacing: 1px; }
        .details { margin-top: 30px; padding-top: 20px; border-top: 1px solid #e5e5e5; }
        .item { display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 14px; }
        .footer { text-align: center; margin-top: 40px; font-size: 12px; color: #666666; }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">SOLEKICKS<span class="dot">.</span></div>
    </div>
    
    <div class="content">
        <h2>Your order is on the way! 🚚</h2>
        <p>Hi <%= order.customer_name %>,</p>
        <p>Great news! Your order <strong>#<%= order.order_number %></strong> has been shipped and is currently with the courier.</p>
        
        <% if (order.tracking_number) { %>
            <div style="background: #ffffff; padding: 15px; border: 1px solid #e5e5e5; margin: 20px 0;">
                <p style="margin: 0; font-size: 12px; color: #666666; text-transform: uppercase; font-weight: bold;">Courier Partner</p>
                <p style="margin: 5px 0 15px 0; font-size: 16px; font-weight: bold;"><%= order.courier_name || 'Our Delivery Partner' %></p>
                
                <p style="margin: 0; font-size: 12px; color: #666666; text-transform: uppercase; font-weight: bold;">Tracking Number</p>
                <p style="margin: 5px 0 0 0; font-size: 20px; font-family: monospace; font-weight: bold;"><%= order.tracking_number %></p>
            </div>
            
            <center>
                <!-- Assuming a generic tracking URL or dynamic one if your courier API supports it -->
                <a href="<%= origin_url %>/track?order=<%= order.order_number %>" class="button">Track Package</a>
            </center>
        <% } else { %>
            <p>Our delivery partner will contact you shortly regarding the delivery schedule.</p>
        <% } %>

        <div class="details">
            <h3 style="font-size: 14px; text-transform: uppercase; color: #666666;">Shipping To:</h3>
            <p style="font-size: 14px; margin: 0;">
                <%= order.shipping_address.address_l1 %><br>
                <% if(order.shipping_address.address_l2) { %><%= order.shipping_address.address_l2 %><br><% } %>
                <%= order.shipping_address.city %>, <%= order.shipping_address.province %><br>
                <%= order.customer_phone %>
            </p>
        </div>
    </div>
    
    <div class="footer">
        <p>If you have any questions, reply to this email or contact us via WhatsApp.</p>
        <p>&copy; <%= new Date().getFullYear() %> SOLEKICKS. All rights reserved.</p>
    </div>
</body>
</html>
